# ===== Wanderer 环境变量配置模板 =====
# 复制此文件为 .env 并填入实际值
# cp .env.example .env

# ===== 必需配置（必须设置）=====

# PocketBase 加密密钥（必须恰好32字符）
# 生成命令: openssl rand -hex 16
# 示例: POCKETBASE_ENCRYPTION_KEY=a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4
POCKETBASE_ENCRYPTION_KEY=

# Meilisearch 主密钥（至少32字符）
# 生成命令: openssl rand -base64 32
# 示例: MEILI_MASTER_KEY=vODkljPcfFANYNepCHyDyGjzAMPcdHnrb6X5KyXQPWo
MEILI_MASTER_KEY=

# 应用访问地址
# 本地开发: http://localhost:3000
# 生产环境: https://yourdomain.com
ORIGIN=http://localhost:3000

# ===== 微信登录配置（可选，如需启用微信登录）=====

# 微信开放平台 AppID
# 在 https://open.weixin.qq.com/ 注册获取
WECHAT_APP_ID=

# 微信开放平台 AppSecret
# 注意：妥善保管，不要泄露
WECHAT_APP_SECRET=

# 微信OAuth回调地址（可选）
# 如果不设置，将自动使用 ORIGIN + /api/v1/auth/wechat/callback
# WECHAT_REDIRECT_URI=https://yourdomain.com/api/v1/auth/wechat/callback

# ===== 地图服务配置 =====

# 高德地图 API Key
# 在 https://console.amap.com/ 注册获取
# 如果不配置，地图功能可能受限
AMAP_KEY=b5279fea2eaa266c9f3ea453811ba7e

# ===== 上传文件配置（可选）=====

# 上传用户认证用户名
UPLOAD_USER=

# 上传用户认证密码
UPLOAD_PASSWORD=

# ===== 其他配置 =====

# 禁用用户注册
# 生产环境建议设为 "true"
# 可选值: "true" 或 "false"
PUBLIC_DISABLE_SIGNUP=false

# 地图最大折线数
PUBLIC_MAP_MAX_POLYLINES=100

# ===== 高级配置（通常不需要修改）=====

# Meilisearch URL（内部服务通信）
MEILI_URL=http://search:7700

# Overpass API URL（OpenStreetMap数据）
OVERPASS_API_URL=https://overpass-api.de

# Valhalla URL（路由服务）
VALHALLA_URL=https://valhalla1.openstreetmap.de

# Nominatim URL（地理编码）
NOMINATIM_URL=https://nominatim.openstreetmap.org

# ===== 安全提示 =====
# 1. 永远不要将 .env 文件提交到版本控制系统
# 2. 生产环境必须使用强随机密钥
# 3. 定期轮换密钥
# 4. 使用 HTTPS 保护传输安全

# ===== 快速生成密钥 =====
# Linux/macOS:
#   openssl rand -hex 16    # PocketBase (32字符)
#   openssl rand -base64 32 # Meilisearch (至少32字符)
#
# Windows PowerShell:
#   -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 32 | ForEach-Object {[char]$_})
#   -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 48 | ForEach-Object {[char]$_})
