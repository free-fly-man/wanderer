# 微信登录配置示例
# 复制此文件为 .env 并填入实际的微信开放平台凭证

# 微信开放平台应用ID（必填）
WECHAT_APP_ID=wx1234567890abcdef

# 微信开放平台应用密钥（必填）
WECHAT_APP_SECRET=your_wechat_app_secret_here

# 微信OAuth回调地址（可选）
# 如果不设置，将自动使用 ORIGIN + /api/v1/auth/wechat/callback
# WECHAT_REDIRECT_URI=https://yourdomain.com/api/v1/auth/wechat/callback

# 注意：
# 1. 请妥善保管AppSecret，不要提交到版本控制系统
# 2. 生产环境必须使用HTTPS
# 3. 在微信开放平台配置的授权回调域必须与这里的域名一致
